*set statement using existed dataset to a
other dataset;
data lab;
input pid age name$ center$ area$;
cards;
100 24 kiran applo hyd
101 25 kumar care vij
102 26 madhu nims nir
103 32 mohan care wng
;
run;
proc print data=lab;
run;
data anthony;
set lab;
run;
proc print data=anthony;
run;
data trial;
set anthony;
run;
proc print data=trial;
run;
**drop option: we can drop variables;
data king;
set trial (drop=pid age);
run;
proc print data=king;
run;
*same keep option only to keep variables;
data ll;
set trial (keep= pid age);
run;
proc print data=ll;
run;
*rename the variable;
data mm;
set ll (rename=(pid=id age=dage));
run;
proc print data=mm;
run;
***where option:-;
proc print data=anthony;
run;
*i want only cares obsn;
data w;
set anthony (where=(center="care"));
run;
proc print data=w;
run;
*firstobs and obs-------------;
proc print data=anthony;
run;
data f;
set anthony (firstobs=2 obs=4);
run;
proc print data=f;
run;

